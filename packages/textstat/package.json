{
  "name": "textstat",
  "version": "0.8.0",
  "description": "textstat is statistic engine for text documents.",
  "keywords": [
    "textlint",
    "textstat"
  ],
  "homepage": "https://github.com/textlint/textstat/tree/master/packages/textstat/",
  "bugs": {
    "url": "https://github.com/textlint/textstat/issues"
  },
  "license": "MIT",
  "author": "azu",
  "files": [
    "bin/",
    "lib/",
    "src/"
  ],
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "bin": {
    "textstat": "bin/cmd.js"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/textlint/textstat.git"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production tsc -p .",
    "clean": "rimraf lib/",
    "prepublish": "npm run --if-present build",
    "test": "mocha \"test/**/*.ts\"",
    "prettier": "prettier --write \"**/*.{js,jsx,ts,tsx,css}\"",
    "watch": "tsc -p . --watch"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": false,
    "tabWidth": 4
  },
  "dependencies": {
    "@textstat/kernel": "^0.8.0",
    "@textstat/rule-context": "^0.8.0",
    "@textstat/textstat-rule-preset-standard": "^0.8.0",
    "@types/json2csv": "^4.5.1",
    "@types/lodash.uniq": "^4.5.7",
    "common-path-prefix": "^3.0.0",
    "globby": "^13.1.2",
    "json2csv": "^4.5.4",
    "lodash.uniq": "^4.5.0",
    "meow": "^10.1.2",
    "os-locale": "^6.0.2"
  },
  "devDependencies": {
    "@types/mocha": "^9.1.1",
    "@types/node": "^17.0.42",
    "cross-env": "^7.0.3",
    "mocha": "^10.0.0",
    "prettier": "^2.7.0",
    "rimraf": "^3.0.2",
    "ts-node": "^10.8.1",
    "ts-node-test-register": "^10.0.0",
    "typescript": "^4.7.3"
  },
  "type": "module"
}
