{
  "name": "@textstat/rule-context",
  "version": "0.8.0",
  "description": "RuleContext for textstat.",
  "keywords": [
    "textstat"
  ],
  "homepage": "https://github.com/textlint/textstat/tree/master/packages/@textstat/rule-context/",
  "bugs": {
    "url": "https://github.com/textlint/textstat/issues"
  },
  "license": "MIT",
  "author": "azu",
  "files": [
    "bin/",
    "lib/",
    "src/"
  ],
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/textlint/textstat.git"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production tsc --build",
