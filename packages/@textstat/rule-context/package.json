    "watch": "tsc --build --watch"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 4
  },
  "dependencies": {
    "@textlint/kernel": "^12.1.1",
    "lodash.template": "^4.5.0",
    "@textlint/types": "^12.1.1",
