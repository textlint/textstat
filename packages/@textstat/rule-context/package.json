  },
  "devDependencies": {
    "@types/lodash.template": "^4.5.1",
    "@types/mocha": "^9.1.1",
    "@types/node": "^17.0.42",
    "cross-env": "^7.0.3",
    "mocha": "^10.0.0",
    "prettier": "^2.7.0",
    "ts-node": "^10.8.1",
    "ts-node-test-register": "^10.0.0",
    "typescript": "^4.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
