    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-plotly.js": "^2.6.0",
    "typescript": "^5.8.3",
    "next": "^15.3.2"
  },
  "devDependencies": {
    "@types/react-plotly.js": "^2.2.2",
    "lint-staged": "^8.1.4",
