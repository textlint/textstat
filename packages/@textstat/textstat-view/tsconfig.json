{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "es7",
      "dom"
    ],
    "allowJs": false,
    "skipLibCheck": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "skipDefaultLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "src",
    "build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
